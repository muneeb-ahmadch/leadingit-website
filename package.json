{
  "name": "leadingit-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "phpmailer": "node scripts/fetch-phpmailer.mjs",
    "prebuild": "node scripts/fetch-phpmailer.mjs && node scripts/gen-sitemap.mjs",
    "build": "tsc -b && vite-react-ssg build",
    "postbuild": "node scripts/clean-build-artifacts.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && eslint .",
    "validate:seo": "node scripts/validate-seo.mjs",
    "gen:schema-vocab": "node scripts/gen-schema-vocab-subset.mjs"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.1.0",
    "@fontsource/noto-nastaliq-urdu": "^5.1.0",
    "framer-motion": "^11.11.17",
    "i18next": "^23.16.8",
    "lenis": "^1.1.18",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "vite-react-ssg": "^0.9.1"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11"
  }
}
