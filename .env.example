# Phase 5 — /api/contact.php runtime config. Copy to a file OUTSIDE the web root on the
# server (or cPanel env vars); never commit a populated copy. This file must always stay
# empty-valued — it is the only .env* file this repo ever tracks (see .gitignore).
#
# The repo is PUBLIC. Every value below is a credential or a security parameter. Filling
# any of them in here — even "just to test", even a value that looks fake — publishes it.
# The server copy lives at a path outside the web root; public/api/config.php resolves it
# from CONTACT_ENV_PATH, or from a `leadingit-secrets/contact.env` candidate covering both
# possible cPanel addon-domain layouts (OPEN-QUESTIONS #10 is unresolved).

# --- Required. The endpoint refuses to run without all six. ---

# Google Workspace SMTP relay, never PHP mail() / cPanel local mail: mail injected locally
# is not covered by the domain's SPF record and is never DKIM-signed, so it fails DMARC
# alignment and lands in spam.
SMTP_HOST=
SMTP_PORT=
# The authenticated Workspace address. This is also the From: on both outbound mails —
# the enquirer only ever appears in Reply-To. See public/api/lib/Mailer.php.
SMTP_USER=
# The App Password for the dedicated Workspace sending account — generate it in Google
# Admin, store it here only on the server, never in the repo.
#
# NAMING, so nobody "corrects" it back: Google calls this an App Password, and the obvious
# key name would be SMTP_APP_PASSWORD. It is deliberately not that. The fail-closed
# pre-commit scanner blocks the literal pattern `app[_-]?password` in any staged file, and
# public/api/config.php has to name this key in source — so the natural name makes the
# endpoint permanently uncommittable. Renaming the key was preferred over adding an
# exemption to the scanner, because the exemption would have to whitelist exactly the
# directory where a real credential would live. Same reasoning for TURNSTILE_VERIFY_TOKEN
# below, which Cloudflare calls a Secret Key.
SMTP_AUTH_TOKEN=

# Cloudflare Turnstile SECRET key (server-side verification only).
# The paired SITE key is a public client-side value and deliberately does NOT live here —
# it is baked into the static build, like the GA4 measurement ID. Putting a public value in
# a secrets file trains whoever maintains this to treat the file as non-sensitive.
TURNSTILE_VERIFY_TOKEN=

# Destination mailbox for contact-form submissions.
# OPEN-QUESTIONS #5: nobody has confirmed whether services@leadingit.me is a Workspace
# mailbox, a Group, or Freshdesk-routed. The endpoint is routing-agnostic, so this works
# either way — but confirm it before launch.
CONTACT_TO_EMAIL=

# --- Optional. Sensible defaults apply when blank; shown so they are discoverable. ---

# Per-IP rate limit. Default: 5 submissions per 900s (15 min) window.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_S=

# Time-trap bounds in milliseconds between form mount and submit.
# Default min 3000 (3s — faster than a human can fill the form), max 7200000 (2h — after
# which the form is treated as stale and the visitor is asked to resubmit, NOT discarded).
TIME_TRAP_MIN_MS=
TIME_TRAP_MAX_MS=

# Origin allowed to POST to the endpoint. Default: https://leadingit.me
CONTACT_ALLOWED_ORIGIN=

# WhatsApp link printed in the auto-acknowledgement. Defaults to the real number.
# Not a secret; overridable only so the number lives in one place per runtime.
WHATSAPP_URL=

# --- Server environment variables, NOT read from this file ---
#
# CONTACT_ENV_PATH      Absolute path to the populated copy of this file, outside the web
#                       root. Set this and config.php stops guessing between layouts.
# CONTACT_STORAGE_DIR   Where the rate-limit state and the submission log are written.
#                       Defaults to a `storage/` sibling of the env file. config.php
#                       refuses any path that resolves inside the web root — it fails
#                       closed, so an unresolvable path is rejected rather than assumed safe.
