# Phase 5 — /api/contact.php runtime config. Copy to a file OUTSIDE the web root on the
# server (or cPanel env vars); never commit a populated copy. This file must always stay
# empty-valued — it is the only .env* file this repo ever tracks (see .gitignore).

# Google Workspace SMTP relay (smtp.gmail.com), never PHP mail() / cPanel local mail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# App Password for the dedicated Workspace sending account — generate in Google Admin,
# store here only on the server, never in the repo.
SMTP_APP_PASSWORD=

# Cloudflare Turnstile secret key (server-side verification), paired with the site key
# used client-side.
TURNSTILE_SECRET_KEY=

# Destination mailbox for contact-form submissions.
CONTACT_TO_EMAIL=
